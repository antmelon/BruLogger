{
  "expo": {
    "name": "BruLogger",
    "owner": "alongo0925",
    "slug": "brulogger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.antmelon.brulogger",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.antmelon.brulogger",
      "adaptiveIcon": {
        "backgroundColor": "#4A3728",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "themeColor": "#F5EFE6",
      "description": "Your personal coffee journal. Track, rate, and remember every brew."
    },
    "scheme": "brulogger",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4A3728",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BruLogger uses your photo library so you can add a photo to a brew.",
          "cameraPermission": "BruLogger uses the camera so you can take a photo of your brew.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "brulogger",
          "project": "brulogger-app",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a94e725e-0fda-4112-89e7-64f50c1cdd7a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a94e725e-0fda-4112-89e7-64f50c1cdd7a"
    }
  }
}
